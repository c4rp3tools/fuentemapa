<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fuentes de Agua Cercanas</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
  :root{
    --azul:#0ea5e9; --azul-osc:#0b2545; --fondo:#f0f7ff;
    --tarjeta:#ffffff; --texto:#0b2545; --borde:#dbeafe;
  }
  body.dark{ --fondo:#0f172a; --tarjeta:#1e293b; --texto:#e2e8f0; --borde:#334155; }
  *{margin:0;padding:0;box-sizing:border-box;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}
  body{display:flex;flex-direction:column;height:100vh;background:var(--fondo);color:var(--texto)}

  header{display:flex;justify-content:space-between;align-items:center;padding:10px 16px;
    background:linear-gradient(90deg,#0b2545,#0ea5e9);color:#fff;box-shadow:0 2px 10px rgba(0,0,0,.25);z-index:1300}
  header h1{font-size:1.05rem;letter-spacing:1px}
  .header-buttons button{background:rgba(255,255,255,.15);border:none;border-radius:50%;width:38px;height:38px;
    font-size:1.05rem;cursor:pointer;margin-left:6px;transition:background .2s}
  .header-buttons button:hover{background:rgba(255,255,255,.35)}

  #contenedor{position:relative;flex:1}
  #map{position:absolute;inset:0;z-index:1}

  /* ── Marcador: silueta de persona caminando ── */
  .user-marker{position:relative;background:transparent;border:none}
  .user-marker .pulse{position:absolute;inset:-10px;border-radius:50%;background:rgba(14,165,233,.35);animation:pulse 2s infinite}
  .user-marker .user-badge{position:absolute;inset:0;background:#fff;border:3px solid var(--azul);border-radius:50%;
    box-shadow:0 2px 8px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center}
  .user-marker .user-badge svg{width:72%;height:72%}
  @keyframes pulse{0%{transform:scale(.55);opacity:.9}100%{transform:scale(1.5);opacity:0}}

  /* ── Marcador: fuentes (gota de agua) ── */
  .fountain-marker{background:transparent;border:none}
  .fountain-marker svg{width:32px;height:32px;filter:drop-shadow(0 2px 3px rgba(0,0,0,.45));transition:transform .15s}
  .fountain-marker:hover svg{transform:scale(1.2)}

  /* ── Overlay inicial ── */
  #overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
    background:rgba(11,37,69,.45);backdrop-filter:blur(2px);z-index:1200}
  .overlay-card{background:var(--tarjeta);color:var(--texto);padding:26px 28px;border-radius:18px;text-align:center;
    max-width:340px;box-shadow:0 10px 30px rgba(0,0,0,.35)}
  .overlay-card p{font-size:.95rem;margin-bottom:6px}
  .overlay-card small{display:block;color:#64748b;margin-bottom:16px}
  #btnSearch{background:linear-gradient(90deg,#0ea5e9,#0369a1);color:#fff;border:none;border-radius:999px;
    padding:12px 22px;font-size:.95rem;font-weight:700;letter-spacing:.5px;cursor:pointer;box-shadow:0 4px 14px rgba(14,165,233,.5)}
  #btnSearch:active{transform:scale(.97)}

  /* ── Estado y contador ── */
  #status{position:absolute;top:12px;left:50%;transform:translateX(-50%);z-index:1200;background:var(--tarjeta);
    color:var(--texto);padding:8px 16px;border-radius:999px;font-size:.85rem;box-shadow:0 2px 10px rgba(0,0,0,.25)}
  #counter{position:absolute;top:12px;left:12px;z-index:1200;background:var(--azul-osc);color:#fff;
    padding:8px 14px;border-radius:999px;font-size:.85rem;box-shadow:0 2px 10px rgba(0,0,0,.3)}

  /* ── Panel de ruta ── */
  #panel{position:absolute;bottom:16px;left:50%;transform:translateX(-50%);width:min(94%,480px);z-index:1200;
    background:var(--tarjeta);color:var(--texto);border-radius:16px;box-shadow:0 10px 30px rgba(0,0,0,.3);padding:14px 16px}
  .panel-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:10px}
  .panel-head strong{font-size:.95rem}
  .panel-head button{border:none;border-radius:999px;padding:7px 12px;font-size:.8rem;cursor:pointer;margin-left:6px}
  #btnShare{background:var(--azul);color:#fff}
  #btnClose{background:#e2e8f0;color:#0b2545}
  body.dark #btnClose{background:#334155;color:#e2e8f0}
  .panel-body{display:flex;flex-wrap:wrap;gap:8px 18px;font-size:.88rem;margin-bottom:8px}
  #panel small{color:#64748b}
  .hidden{display:none !important}
</style>
  <link rel="manifest" href="/fuentemapa/manifest.json">
  <link rel="apple-touch-icon" href="/fuentemapa/icon-192.png">
  <meta name="theme-color" content="#0b1e33">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
</head>
<body>

<header>
  <h1>🚰 FUENTES DE AGUA</h1>
  <div class="header-buttons">
    <button id="btnDark" type="button" title="Modo oscuro">🌙</button>
    <button id="btnRefresh" type="button" title="Actualizar fuentes">🔄</button>
    <button id="btnLocate" type="button" title="Mi ubicación">📍</button>
  </div>
</header>

<div id="contenedor">
  <div id="map"></div>

  <div id="overlay">
    <div class="overlay-card">
      <p>🗺️ Pulsa el botón para buscar fuentes de agua potable cerca de ti</p>
      <small>Usando datos de OpenStreetMap</small>
      <button id="btnSearch" type="button">💧 BUSCAR FUENTES 🗺️</button>
    </div>
  </div>

  <div id="status">Listo para buscar</div>
  <div id="counter" class="hidden"></div>

  <div id="panel" class="hidden">
    <div class="panel-head">
      <strong>🗺️ Ruta a la fuente</strong>
      <div>
        <button id="btnShare" type="button">📤 Compartir</button>
        <button id="btnClose" type="button">✕ Cerrar</button>
      </div>
    </div>
    <div class="panel-body">
      <span>📏 Distancia: <b id="dist">---</b></span>
      <span>⏱ Tiempo a pie: <b id="time">---</b></span>
      <span>📍 Fuente: <b id="fname">---</b></span>
    </div>
    <small>💾 Ruta calculada en tiempo real</small>
  </div>
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
/* ═══════════ MAPA BASE ═══════════ */
const map = L.map('map').setView([40.4168, -3.7038], 13);
const tilesClaro  = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {maxZoom:19, attribution:'&copy; OpenStreetMap'});
const tilesOscuro = L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {maxZoom:19, attribution:'&copy; OpenStreetMap &copy; CARTO'});
tilesClaro.addTo(map);

/* ═══════════ ESTADO ═══════════ */
let userPos = null, userMarker = null, accCircle = null, rutaLinea = null;
let fuenteSel = null, modoOscuro = false;
const fuentesLayer = L.layerGroup().addTo(map);
const RADIO = 2000; // metros

/* ═══════════ ICONOS ═══════════ */
// Silueta de persona caminando (tu ubicación)
const walkerSVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="#0b2545">
<path d="M13.5 5.5c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zM9.8 8.9L7 23h2.1l1.8-8 2.1 2v6h2v-7.5l-2.1-2 .6-3C14.8 12 16.8 13 19 13v-2c-1.9 0-3.5-1-4.3-2.4l-1-1.6c-.4-.6-1-1-1.7-1-.3 0-.5.1-.8.1L6 8.3V13h2V9.6l1.8-.7"/></svg>`;
const userIcon = L.divIcon({
  className:'user-marker',
  html:`<div class="pulse"></div><div class="user-badge">${walkerSVG}</div>`,
  iconSize:[46,46], iconAnchor:[23,23]
});
// Gota de agua para cada fuente
const dropSVG = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
<path d="M12 1.8c4.2 6 7.2 9.7 7.2 13.4a7.2 7.2 0 1 1-14.4 0C4.8 11.5 7.8 7.8 12 1.8z"
fill="#0ea5e9" stroke="#ffffff" stroke-width="1.6"/></svg>`;
const fuenteIcon = L.divIcon({className:'fountain-marker', html:dropSVG, iconSize:[32,32], iconAnchor:[16,30]});

/* ═══════════ UTILIDADES ═══════════ */
const $ = id => document.getElementById(id);
function setStatus(msg, ms){ $('status').textContent = msg; if(ms) setTimeout(()=> $('status').classList.add('hidden'), ms); else $('status').classList.remove('hidden'); }
const fmtDist = m => m < 1000 ? `${Math.round(m)} m` : `${(m/1000).toFixed(2)} km`;
const fmtTime = min => min < 60 ? `${Math.max(1,Math.round(min))} min` : `${Math.floor(min/60)} h ${Math.round(min%60)} min`;

function obtenerPosicion(){
  return new Promise((res, rej) => {
    if(!navigator.geolocation) return rej(new Error('Geolocalización no disponible'));
    navigator.geolocation.getCurrentPosition(p => res([p.coords.latitude, p.coords.longitude]),
      () => rej(new Error('Permiso de ubicación denegado')), {enableHighAccuracy:true, timeout:10000});
  });
}

function marcarUsuario(pos){
  userPos = pos;
  if(userMarker) map.removeLayer(userMarker);
  if(accCircle)  map.removeLayer(accCircle);
  userMarker = L.marker(pos, {icon:userIcon, zIndexOffset:1000}).addTo(map).bindTooltip('Tu ubicación');
  map.setView(pos, 16);
}

/* ═══════════ BÚSQUEDA (Overpass / OpenStreetMap) ═══════════ */
async function buscarFuentes(){
  $('overlay').classList.add('hidden');
  setStatus('📍 Obteniendo ubicación...');
  let pos;
  try { pos = await obtenerPosicion(); }
  catch(e){ pos = [map.getCenter().lat, map.getCenter().lng]; setStatus('⚠️ Sin GPS: usando el centro del mapa'); }
  marcarUsuario(pos);

  setStatus('💧 Buscando fuentes cercanas...');
  const q = `[out:json][timeout:25];(
    node["amenity"="drinking_water"](around:${RADIO},${pos[0]},${pos[1]});
    node["amenity"="fountain"]["drinking_water"="yes"](around:${RADIO},${pos[0]},${pos[1]});
    way["amenity"="drinking_water"](around:${RADIO},${pos[0]},${pos[1]});
  );out center body 200;`;

  try{
    const r = await fetch('https://overpass-api.de/api/interpreter',
      {method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body:'data='+encodeURIComponent(q)});
    const datos = await r.json();
    const vistas = new Set();
    const fuentes = (datos.elements || []).map(e => {
      const lat = e.lat ?? e.center?.lat, lon = e.lon ?? e.center?.lon;
      if(lat == null) return null;
      const clave = lat.toFixed(5)+','+lon.toFixed(5);
      if(vistas.has(clave)) return null; vistas.add(clave);
      return {lat, lon, nombre: e.tags?.name || 'Fuente de agua potable'};
    }).filter(Boolean)
      .sort((a,b) => map.distance(pos, [a.lat,a.lon]) - map.distance(pos, [b.lat,b.lon]));

    fuentesLayer.clearLayers();
    if(!fuentes.length){ setStatus('😕 No se encontraron fuentes en 2 km'); $('counter').classList.add('hidden'); return; }

    fuentes.forEach(f => {
      L.marker([f.lat, f.lon], {icon:fuenteeIconSafe()}).addTo(fuentesLayer)
        .bindTooltip(f.nombre).on('click', () => seleccionarFuente(f));
    });

    $('counter').textContent = `💧 ${fuentes.length} fuentes encontradas`;
    $('counter').classList.remove('hidden');
    map.fitBounds(L.latLngBounds([pos, ...fuentes.map(f=>[f.lat,f.lon])]), {padding:[50,50]});
    setStatus(`✅ ${fuentes.length} fuentes marcadas en el mapa`, 4000);
    seleccionarFuente(fuentes[0]); // resalta la más cercana
  }catch(err){
    setStatus('❌ Error al consultar OpenStreetMap');
  }
}
function fuenteeIconSafe(){ return fuenteIcon; }

/* ═══════════ RUTA A LA FUENTE ═══════════ */
async function seleccionarFuente(f){
  fuenteSel = f;
  if(rutaLinea) map.removeLayer(rutaLinea);
  const desde = userPos || [map.getCenter().lat, map.getCenter().lng];
  $('fname').textContent = f.nombre;
  $('panel').classList.remove('hidden');
  setStatus('🗺️ Calculando ruta...');

  let coords = null, dist = null, min = null;
  try{
    const url = `https://routing.openstreetmap.de/routed-foot/route/v1/foot/${desde[1]},${desde[0]};${f.lon},${f.lat}?overview=full&geometries=geojson`;
    const r = await fetch(url); const j = await r.json();
    if(j.routes && j.routes.length){
      coords = j.routes[0].geometry.coordinates.map(c => [c[1], c[0]]);
      dist = j.routes[0].distance; min = j.routes[0].duration / 60;
    }
  }catch(e){}
  if(!coords){ // respaldo: línea recta
    coords = [desde, [f.lat, f.lon]];
    dist = map.distance(desde, [f.lat, f.lon]); min = dist / 80; // ~4,8 km/h
  }

  rutaLinea = L.polyline(coords, {color:'#0ea5e9', weight:5, opacity:.85}).addTo(map);
  map.fitBounds(rutaLinea.getBounds(), {padding:[60,60]});
  $('dist').textContent = fmtDist(dist);
  $('time').textContent = fmtTime(min);
  setStatus('💾 Ruta calculada en tiempo real', 3000);
}

/* ═══════════ BOTONES ═══════════ */
$('btnSearch').onclick  = buscarFuentes;
$('btnRefresh').onclick = buscarFuentes;
$('btnLocate').onclick  = async () => { setStatus('📍 Obteniendo ubicación...'); try{ marcarUsuario(await obtenerPosicion()); setStatus('📍 Ubicación actualizada', 2500);}catch(e){ setStatus('⚠️ No se pudo obtener la ubicación'); } };
$('btnClose').onclick   = () => { $('panel').classList.add('hidden'); if(rutaLinea){ map.removeLayer(rutaLinea); rutaLinea = null; } };
$('btnShare').onclick   = async () => {
  if(!fuenteSel) return;
  const texto = `🚰 ${fuenteSel.nombre} | 📏 ${$('dist').textContent} | ⏱ ${$('time').textContent} a pie\n🗺️ https://www.openstreetmap.org/?mlat=${fuenteSel.lat}&mlon=${fuenteSel.lon}#map=17/${fuenteSel.lat}/${fuenteSel.lon}`;
  if(navigator.share){ try{ await navigator.share({title:'Fuente de agua', text:texto}); }catch(e){} }
  else{ await navigator.clipboard.writeText(texto); setStatus('📤 Ruta copiada al portapapeles', 2500); }
};
$('btnDark').onclick = () => {
  modoOscuro = !modoOscuro;
  document.body.classList.toggle('dark', modoOscuro);
  map.removeLayer(modoOscuro ? tilesClaro : tilesOscuro);
  (modoOscuro ? tilesOscuro : tilesClaro).addTo(map);
};
</script>

<script>
if ('serviceWorker' in navigator) {
  window.addEventListener('load', function() {
    navigator.serviceWorker.register('/fuentemapa/sw.js', { scope: '/fuentemapa/' })
      .then(function(registration) {
        console.log('✅ Service Worker registrado con scope:', registration.scope);
      })
      .catch(function(err) {
        console.log('❌ Error al registrar SW:', err);
      });
  });
}
</script>
</body>
</html>
